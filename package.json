{
  "name": "opencode-rundev",
  "version": "0.1.3",
  "description": "Run & Debug for the terminal-first world: bring a repo's dev environment up and down from OpenCode — containers, dev servers, emulators — with no LLM in the loop.",
  "type": "module",
  "license": "MIT",
  "author": "Angelo Quijano Orduña <angelo@globoazul.pe>",
  "homepage": "https://github.com/angeloper86/opencode-rundev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angeloper86/opencode-rundev.git"
  },
  "bugs": {
    "url": "https://github.com/angeloper86/opencode-rundev/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "rundev.schema.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "dev-environment",
    "docker-compose",
    "run-and-debug",
    "rundev"
  ],
  "engines": {
    "opencode": ">=2.0.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.11",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "^2.0.11",
    "@opencode/plugin": "^2.0.11",
    "@opencode/theme": "^2.0.11",
    "@opentui/core": "^0.5.11",
    "@opentui/solid": "^0.5.11",
    "@types/node": "^22.0.0",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "deno run -A dev/smoke.ts",
    "prepublishOnly": "npm run typecheck && npm run smoke"
  }
}
